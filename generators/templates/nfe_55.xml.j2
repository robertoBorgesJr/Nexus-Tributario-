<?xml version="1.0" encoding="UTF-8"?>
<nfeProc versao="4.00" xmlns="http://www.portalfiscal.inf.br/nfe">
  <NFe xmlns="http://www.portalfiscal.inf.br/nfe">
    <infNFe versao="4.00" Id="NFe{{ chave }}">
      <ide>
        <cUF>{{ empresa.cuf }}</cUF>
        <cNF>{{ chave[35:43] }}</cNF>
        <natOp>VENDA DE MERCADORIA</natOp>
        <mod>55</mod>
        <serie>{{ serie }}</serie>
        <nNF>{{ nnf }}</nNF>
        <dhEmi>{{ dh_emi }}</dhEmi>
        <tpNF>1</tpNF>
        <idDest>{{ id_dest }}</idDest>
        <cMunFG>{{ empresa.cmun }}</cMunFG>
        <tpImp>1</tpImp>
        <tpEmis>1</tpEmis>
        <cDV>{{ chave[-1] }}</cDV>
        <tpAmb>2</tpAmb>
        <finNFe>1</finNFe>
        <indFinal>0</indFinal>
        <indPres>9</indPres>
        <procEmi>0</procEmi>
        <verProc>1.0.0</verProc>
      </ide>
      <emit>
        <CNPJ>{{ empresa.cnpj }}</CNPJ>
        <xNome>{{ empresa.razao_social }}</xNome>
        <xFant>{{ empresa.nome_fantasia }}</xFant>
        <enderEmit>
          <xLgr>{{ empresa.logradouro }}</xLgr>
          <nro>{{ empresa.numero }}</nro>
          <xBairro>{{ empresa.bairro }}</xBairro>
          <cMun>{{ empresa.cmun }}</cMun>
          <xMun>{{ empresa.municipio }}</xMun>
          <UF>{{ empresa.uf }}</UF>
          <CEP>{{ empresa.cep }}</CEP>
          <cPais>1058</cPais>
          <xPais>BRASIL</xPais>
        </enderEmit>
        <IE>{{ empresa.ie }}</IE>
        <CRT>{{ empresa.crt }}</CRT>
      </emit>
      <dest>
        <CNPJ>{{ cliente.cnpj }}</CNPJ>
        <xNome>{{ cliente.xnome }}</xNome>
        <enderDest>
          <xLgr>{{ cliente.logradouro }}</xLgr>
          <nro>{{ cliente.numero }}</nro>
          <xBairro>{{ cliente.bairro }}</xBairro>
          <cMun>{{ cliente.cmun }}</cMun>
          <xMun>{{ cliente.municipio }}</xMun>
          <UF>{{ cliente.uf }}</UF>
          <CEP>{{ cliente.cep }}</CEP>
          <cPais>1058</cPais>
          <xPais>BRASIL</xPais>
        </enderDest>
        <indIEDest>1</indIEDest>
        <IE>{{ cliente.ie }}</IE>
      </dest>
      <det nItem="1">
        <prod>
          <cProd>{{ produto.cprod }}</cProd>
          <cEAN>{{ produto.cean }}</cEAN>
          <xProd>{{ produto.xprod }}</xProd>
          <NCM>{{ produto.ncm }}</NCM>
          <CFOP>{{ cfop }}</CFOP>
          <uCom>{{ produto.ucom }}</uCom>
          <qCom>{{ "%.4f"|format(qtd) }}</qCom>
          <vUnCom>{{ "%.10f"|format(v_unit) }}</vUnCom>
          <vProd>{{ "%.2f"|format(v_prod) }}</vProd>
          <cEANTrib>{{ produto.cean }}</cEANTrib>
          <uTrib>{{ produto.ucom }}</uTrib>
          <qTrib>{{ "%.4f"|format(qtd) }}</qTrib>
          <vUnTrib>{{ "%.10f"|format(v_unit) }}</vUnTrib>
          <indTot>1</indTot>
        </prod>
        <imposto>
          <ICMS>
            <ICMS00>
              <orig>0</orig>
              <CST>{{ cst_icms }}</CST>
              <modBC>3</modBC>
              <vBC>{{ "%.2f"|format(v_bc_icms) }}</vBC>
              <pICMS>{{ "%.2f"|format(aliq_icms) }}</pICMS>
              <vICMS>{{ "%.2f"|format(v_icms) }}</vICMS>
            </ICMS00>
          </ICMS>
          {% if aliq_ipi > 0 %}
          <IPI>
            <cEnq>999</cEnq>
            <IPITrib>
              <CST>50</CST>
              <vBC>{{ "%.2f"|format(v_prod) }}</vBC>
              <pIPI>{{ "%.2f"|format(aliq_ipi) }}</pIPI>
              <vIPI>{{ "%.2f"|format(v_ipi) }}</vIPI>
            </IPITrib>
          </IPI>
          {% endif %}
          <PIS>
            {% if aliq_pis > 0 %}
            <PISAliq>
              <CST>{{ cst_pis }}</CST>
              <vBC>{{ "%.2f"|format(v_bc_pis) }}</vBC>
              <pPIS>{{ "%.4f"|format(aliq_pis) }}</pPIS>
              <vPIS>{{ "%.2f"|format(v_pis) }}</vPIS>
            </PISAliq>
            {% else %}
            <PISOutr>
              <CST>{{ cst_pis }}</CST>
              <vBC>0.00</vBC>
              <pPIS>0.0000</pPIS>
              <vPIS>0.00</vPIS>
            </PISOutr>
            {% endif %}
          </PIS>
          <COFINS>
            {% if aliq_cofins > 0 %}
            <COFINSAliq>
              <CST>{{ cst_cofins }}</CST>
              <vBC>{{ "%.2f"|format(v_bc_cofins) }}</vBC>
              <pCOFINS>{{ "%.4f"|format(aliq_cofins) }}</pCOFINS>
              <vCOFINS>{{ "%.2f"|format(v_cofins) }}</vCOFINS>
            </COFINSAliq>
            {% else %}
            <COFINSOutr>
              <CST>{{ cst_cofins }}</CST>
              <vBC>0.00</vBC>
              <pCOFINS>0.0000</pCOFINS>
              <vCOFINS>0.00</vCOFINS>
            </COFINSOutr>
            {% endif %}
          </COFINS>
        </imposto>
      </det>
      <total>
        <ICMSTot>
          <vBC>{{ "%.2f"|format(v_bc_icms) }}</vBC>
          <vICMS>{{ "%.2f"|format(v_icms) }}</vICMS>
          <vICMSDeson>0.00</vICMSDeson>
          <vFCP>0.00</vFCP>
          <vBCST>0.00</vBCST>
          <vST>0.00</vST>
          <vFCPST>0.00</vFCPST>
          <vFCPSTRet>0.00</vFCPSTRet>
          <vProd>{{ "%.2f"|format(v_prod) }}</vProd>
          <vFrete>0.00</vFrete>
          <vSeg>0.00</vSeg>
          <vDesc>0.00</vDesc>
          <vII>0.00</vII>
          <vIPI>{{ "%.2f"|format(v_ipi) }}</vIPI>
          <vIPIDevol>0.00</vIPIDevol>
          <vPIS>{{ "%.2f"|format(v_pis) }}</vPIS>
          <vCOFINS>{{ "%.2f"|format(v_cofins) }}</vCOFINS>
          <vOutro>0.00</vOutro>
          <vNF>{{ "%.2f"|format(v_nf) }}</vNF>
        </ICMSTot>
      </total>
      <transp>
        <modFrete>9</modFrete>
      </transp>
      <cobr>
        <dup>
          <nDup>001</nDup>
          <dVenc>{{ dh_emi[:10] }}</dVenc>
          <vDup>{{ "%.2f"|format(v_nf) }}</vDup>
        </dup>
      </cobr>
      <infAdic>
        <infCpl>NOTA FISCAL SINTETICA - AMBIENTE DE HOMOLOGACAO (tpAmb=2)</infCpl>
      </infAdic>
    </infNFe>
  </NFe>
  <protNFe versao="4.00">
    <infProt>
      <tpAmb>2</tpAmb>
      <verAplic>SP_NFE_PL_009_V4</verAplic>
      <chNFe>{{ chave }}</chNFe>
      <dhRecbto>{{ dh_emi }}</dhRecbto>
      <nProt>{{ chave[:15] }}00001</nProt>
      <cStat>100</cStat>
      <xMotivo>Autorizado o uso da NF-e</xMotivo>
    </infProt>
  </protNFe>
</nfeProc>
