# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# .env nunca deve ser commitado (já está no .gitignore).
#
# Credenciais Databricks (host, token, serverless_compute_id) NÃO ficam aqui.
# Configure em ~/.databrickscfg (Databricks Unified Auth):
#
#   [DEFAULT]
#   host                     = https://adb-XXXXXXXXXX.azuredatabricks.net
#   token                    = dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#   serverless_compute_id    = auto

# ── Unity Catalog ─────────────────────────────────────────────────────────────
DATABRICKS_CATALOG    = nexus_tributario_prod

# ── ADLS Gen2 ─────────────────────────────────────────────────────────────────
ADLS_STORAGE_ACCOUNT  = stnexustributarioprod
ADLS_FILESYSTEM       = nexus-data
